# MediVoice Frontend Environment Variables

# Backend API URL (use your deployed backend URL on Render/Railway with https://)
VITE_BACKEND_URL=https://your-medivoice-backend.onrender.com

# Backend WebSocket URL (wss:// for secure WebSockets in production)
# Note: If omitted, the app will automatically convert https:// to wss://
VITE_WS_URL=wss://your-medivoice-backend.onrender.com
